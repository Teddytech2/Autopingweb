# Copy values into Railway → Service → Variables.
# config.js reads all environment settings in one place.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=teddy_autoping
CRON_SECRET=replace-with-a-long-random-secret

# Railway supplies PORT automatically. Do not hardcode it in production.
